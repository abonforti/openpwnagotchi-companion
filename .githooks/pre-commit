#!/usr/bin/env python3
"""Local commit gates: what must not be published, and what must not be shipped.

The denylist is NOT stored in this repository and its path is NOT hardcoded here:
it names the very things that must never be published. Point git at it once, with

    git config companion.denylist /path/to/your/denylist.txt

One case-insensitive Python regular expression per line; blank lines and lines
starting with # are ignored. Python regex, not grep: the patterns need lookahead
to carve generic constants out of a broader range.

This is the cheap automatic layer. The companion-security-auditor agent is the
thorough one and applies judgement this script cannot. Run both.
"""

import re
import subprocess
import sys
from pathlib import Path


def git(*args, tolerate=()):
    """Runs git and returns stdout, refusing to treat a failed call as no output.

    Every caller here reads the result as evidence: an empty answer means "nothing
    is staged" and the hook exits 0. A git that could not run returns an empty
    stdout too, so swallowing the status turns a check that did not happen into a
    clean result, which is the one thing a leak gate must never do (SPEC 13).

    `tolerate` names exit statuses that carry meaning rather than failure, so the
    caller can act on them: `config --get` exits 1 for a key that is not set.
    """
    result = subprocess.run(["git", *args], capture_output=True, text=True, check=False)
    if result.returncode and result.returncode not in tolerate:
        fail(
            f"pre-commit: `git {' '.join(args)}` failed with status {result.returncode}.",
            "  The leak gate could not read the staged diff, so it has not run.",
            "  Refusing to commit rather than reporting a scan that did not happen.",
        )
    return result.stdout


def fail(*lines):
    for line in lines:
        print(line, file=sys.stderr)
    sys.exit(1)


# The shipped-inventory gate runs first and runs unconditionally, because the
# file it catches is typically untracked: `git add -A` is what sweeps a scratch
# directory into a commit, and until that happens there is no staged diff to
# scan. Same script CI runs, so the two cannot drift (SPEC 13.2).
shipped_check = Path(__file__).resolve().parent.parent / ".github" / "check_shipped_files.py"
if not shipped_check.is_file():
    fail(
        "pre-commit: .github/check_shipped_files.py is missing, so the shipped-inventory "
        "gate has not run.",
        "  This hook expects to be reached through `git config core.hooksPath .githooks`.",
        "  A hook copied into .git/hooks/ cannot find the rest of the repository.",
    )
shipped = subprocess.run([sys.executable, str(shipped_check)], capture_output=True, text=True)
if shipped.returncode:
    fail(
        shipped.stdout.rstrip(),
        shipped.stderr.rstrip(),
        "pre-commit: a directory that ships to the unit holds a file nobody declared.",
    )

denylist_path = git("config", "--get", "companion.denylist", tolerate=(1,)).strip()
if not denylist_path:
    fail(
        "pre-commit: companion.denylist is not configured.",
        "  git config companion.denylist /path/to/your/denylist.txt",
        "  Refusing to commit without the leak gate. See SPEC.md section 13.",
    )

try:
    with open(denylist_path, encoding="utf-8") as fp:
        raw = fp.read().splitlines()
except OSError as err:
    fail(f"pre-commit: denylist unreadable ({err.strerror}). Refusing to commit.")

patterns = []
for lineno, line in enumerate(raw, 1):
    line = line.strip()
    if not line or line.startswith("#"):
        continue
    try:
        patterns.append(re.compile(line, re.IGNORECASE))
    except re.error as err:
        fail(f"pre-commit: denylist line {lineno} is not a valid regex: {err}")

if not patterns:
    fail("pre-commit: denylist contains no patterns. Refusing to commit.")

staged = [n for n in git("diff", "--cached", "--name-only", "--diff-filter=ACM").split("\n") if n]
if not staged:
    sys.exit(0)

# Added lines only. An untouched pre-existing line is a separate problem, not this
# commit's, and re-reporting it every time trains people to ignore the hook.
diff = git("diff", "--cached", "--unified=0", "--", *staged)
added = [ln[1:] for ln in diff.split("\n") if ln.startswith("+") and not ln.startswith("+++")]
if not added:
    sys.exit(0)

hits = sum(1 for p in patterns if any(p.search(ln) for ln in added))

if hits:
    fail(
        f"pre-commit: {hits} denylist pattern(s) matched in the staged diff.",
        "",
        # The matching line is deliberately not printed: it is the secret.
        "  This repository is public. Move the content outside the repository.",
        "  Review with: git diff --cached",
    )

sys.exit(0)
