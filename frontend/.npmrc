# SPEC 5.1.1, issue #132. `engines` is advisory by default: `npm install` under a Node
# below the floor prints EBADENGINE and carries on, and the suite then dies inside undici
# with `webidl.util.markAsUncloneable is not a function`, which names neither Node nor a
# version. This turns that warning into a refusal.
#
# It is in frontend/ and deliberately not at the repository root: it applies to an install
# of the frontend's own dependencies, which is by definition frontend work, so it cannot
# block a contributor who only touches plugin/, tools/ or tests/.
engine-strict=true

# Nothing else belongs in this file. A project-level .npmrc is where
# `npm config set --location=project` writes a registry credential
# (`//registry.npmjs.org/:_authToken=`), and this one is tracked in a public
# repository. `.github/check_secrets.py` refuses those keys by name.
#
# Be precise about when that catches you, because the difference matters: that
# scanner runs in CI and nowhere else. `.githooks/pre-commit` runs the
# out-of-repository denylist and not this one, so a credential written here is
# caught after it has been pushed to a public remote, not before. Issue #203
# carries the wiring. Until it lands, treat this file as one you check by
# looking.
