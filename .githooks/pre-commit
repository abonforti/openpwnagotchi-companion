#!/usr/bin/env python3
"""Local commit gates: what must not be published, and what must not be shipped.

The denylist is NOT stored in this repository and its path is NOT hardcoded here:
it names the very things that must never be published. Point git at it once, with

    git config companion.denylist /path/to/your/denylist.txt

One case-insensitive Python regular expression per line; blank lines and lines
starting with # are ignored. Python regex, not grep: the patterns need lookahead
to carve generic constants out of a broader range.

This is the cheap automatic layer. The companion-security-auditor agent is the
thorough one and applies judgement this script cannot. Run both.
"""

import hashlib
import os
import re
import subprocess
import sys
from pathlib import Path

# Roots a denylist must never resolve under: a list that a reboot or an
# unrelated cleanup can wipe is a gate that will one day be missing. Checked
# against the real, symlink-resolved path and compared by path components
# (`/tmpfoo` is not `/tmp`), not by string prefix.
_TEMP_ROOTS = ("/tmp", "/var/tmp", "/dev/shm")
# Environment-named roots, same argument: $TMPDIR by convention, and
# $XDG_RUNTIME_DIR is a tmpfs wiped at logout.
_TEMP_ROOT_VARIABLES = ("TMPDIR", "XDG_RUNTIME_DIR")


def _resolves_under_temp_dir(path):
    resolved = Path(os.path.realpath(path)).parts
    roots = list(_TEMP_ROOTS)
    for variable in _TEMP_ROOT_VARIABLES:
        value = os.environ.get(variable)
        if value:
            roots.append(value)
    for root in roots:
        root_parts = Path(os.path.realpath(root)).parts
        if resolved[: len(root_parts)] == root_parts:
            return True
    return False


def git(*args, tolerate=()):
    """Runs git and returns stdout, refusing to treat a failed call as no output.

    Every caller here reads the result as evidence: an empty answer means "nothing
    is staged" and the hook exits 0. A git that could not run returns an empty
    stdout too, so swallowing the status turns a check that did not happen into a
    clean result, which is the one thing a leak gate must never do (SPEC 13).

    `tolerate` names exit statuses that carry meaning rather than failure, so the
    caller can act on them: `config --get` exits 1 for a key that is not set.
    """
    result = subprocess.run(["git", *args], capture_output=True, text=True, check=False)
    if result.returncode and result.returncode not in tolerate:
        fail(
            f"pre-commit: `git {' '.join(args)}` failed with status {result.returncode}.",
            "  The leak gate could not read the staged diff, so it has not run.",
            "  Refusing to commit rather than reporting a scan that did not happen.",
        )
    return result.stdout


def fail(*lines):
    for line in lines:
        print(line, file=sys.stderr)
    sys.exit(1)


# The shipped-inventory gate runs first and runs unconditionally, because the
# file it catches is typically untracked: `git add -A` is what sweeps a scratch
# directory into a commit, and until that happens there is no staged diff to
# scan. Same script CI runs, so the two cannot drift (SPEC 13.2).
shipped_check = Path(__file__).resolve().parent.parent / ".github" / "check_shipped_files.py"
if not shipped_check.is_file():
    fail(
        "pre-commit: .github/check_shipped_files.py is missing, so the shipped-inventory "
        "gate has not run.",
        "  This hook expects to be reached through `git config core.hooksPath .githooks`.",
        "  A hook copied into .git/hooks/ cannot find the rest of the repository.",
    )
shipped = subprocess.run([sys.executable, str(shipped_check)], capture_output=True, text=True)
if shipped.returncode:
    fail(
        shipped.stdout.rstrip(),
        shipped.stderr.rstrip(),
        "pre-commit: a directory that ships to the unit holds a file nobody declared.",
    )

# The generic secret scan runs next, and runs unconditionally too, for the
# same reason the shipped-inventory gate does: it is the half of the leak
# defence that used to run only in CI, after a push, and SPEC.md section 13.3
# is what moved it here. It reads staged content, not the working tree, so a
# file clean on disk and dirty in the index is still caught.
secret_check = Path(__file__).resolve().parent.parent / ".github" / "check_secrets.py"
if not secret_check.is_file():
    fail(
        "pre-commit: .github/check_secrets.py is missing, so the secret scan has not run.",
        "  This hook expects to be reached through `git config core.hooksPath .githooks`.",
        "  A hook copied into .git/hooks/ cannot find the rest of the repository.",
    )
try:
    secrets = subprocess.run(
        [sys.executable, str(secret_check), "--staged"], capture_output=True, text=True
    )
except OSError as err:
    fail(
        f"pre-commit: could not run the secret scan ({err.strerror or err}).",
        "  Refusing to commit rather than reporting a scan that did not run.",
    )
if secrets.returncode == 1:
    # check_secrets.py writes its findings to stderr, never to stdout - stdout
    # is only ever the success wording, and this is not that path. Only
    # stderr is printed, so the first line an author sees at commit time is
    # the finding itself, not a blank line where stdout would have been.
    fail(
        secrets.stderr.rstrip(),
        "pre-commit: the secret scan found a possible credential in the staged content.",
    )
elif secrets.returncode != 0:
    # Anything other than 0 (clean) or 1 (a finding to act on) is the scan
    # itself failing to run to completion - a missing interpreter, a crash,
    # an unreadable index - and SPEC.md section 13 rule 6 applies here as much
    # as to any other gate: fail closed and say so, rather than let a status
    # this hook does not recognise pass as a green run.
    fail(
        secrets.stderr.rstrip(),
        f"pre-commit: the secret scan exited {secrets.returncode}, not 0 or 1.",
        "  Refusing to commit rather than reporting a scan that did not run to completion.",
    )

denylist_path = git("config", "--get", "companion.denylist", tolerate=(1,)).strip()
if not denylist_path:
    fail(
        "pre-commit: companion.denylist is not configured.",
        "  git config companion.denylist /path/to/your/denylist.txt",
        "  Refusing to commit without the leak gate. See SPEC.md section 13.",
    )

if not os.path.isabs(denylist_path):
    fail(
        f"pre-commit: companion.denylist is set to {denylist_path}, which is not an "
        "absolute path.",
        "  A relative value resolves against wherever git runs the hook from, which is "
        "inside this repository.",
        "  Point it at an absolute path in your own home directory. Refusing to commit.",
    )

if _resolves_under_temp_dir(denylist_path):
    fail(
        f"pre-commit: companion.denylist is set to {denylist_path}, which resolves under "
        "a temporary directory.",
        "  A leak gate whose list can be wiped by a reboot or an unrelated cleanup is a "
        "gate that will one day be missing.",
        "  Point it at a file in your own home directory instead. Refusing to commit.",
    )

try:
    with open(denylist_path, "rb") as fp:
        raw_bytes = fp.read()
except OSError as err:
    fail(
        f"pre-commit: companion.denylist is set to {denylist_path}, but that file could "
        f"not be read ({err.strerror or err}).",
        "  A repointed or wiped list is the likely cause. Refusing to commit.",
    )

try:
    raw = raw_bytes.decode("utf-8").splitlines()
except UnicodeDecodeError as err:
    fail(
        f"pre-commit: companion.denylist is set to {denylist_path}, which is not UTF-8 "
        f"text (byte {err.start}).",
        "  A denylist is a text file of one regex per line. Refusing to commit.",
    )

patterns = []
for lineno, line in enumerate(raw, 1):
    line = line.strip()
    if not line or line.startswith("#"):
        continue
    try:
        patterns.append(re.compile(line, re.IGNORECASE))
    except re.error as err:
        fail(f"pre-commit: denylist line {lineno} is not a valid regex: {err}")

if not patterns:
    fail("pre-commit: denylist contains no patterns. Refusing to commit.")

# Fingerprint of the list, not its content: enough for the owner to notice
# the list changed between two commits, without printing the path or a
# pattern into a log a leak gate is supposed to keep those out of.
fingerprint = hashlib.sha256(raw_bytes).hexdigest()[:8]
fingerprint_line = (
    f"pre-commit: denylist compiled {len(patterns)} pattern(s), fingerprint {fingerprint}."
)

# This is `d` - exclude deletions, admit everything else - and not an
# allow-list of the letters that were thought of. It started as `ACM`, missed
# a commit that renamed a file and edited it in the same breath (`git mv`,
# then an edit - git calls that R, not M, so `--name-only` named nothing for
# it), grew to `ACMR`, and then missed the same shape again for T: a regular
# file staged over a symlink or the reverse. Two holes from the same cause in
# one evening means the letters are not this gate's to keep enumerating.
# `--name-only` prints the new name for a renamed or type-changed entry,
# which is what the diff below needs anyway.
staged = [n for n in git("diff", "--cached", "--name-only", "--diff-filter=d").split("\n") if n]
if not staged:
    print(fingerprint_line)
    sys.exit(0)

# Added lines only. An untouched pre-existing line is a separate problem, not this
# commit's, and re-reporting it every time trains people to ignore the hook.
diff = git("diff", "--cached", "--unified=0", "--", *staged)
added = [ln[1:] for ln in diff.split("\n") if ln.startswith("+") and not ln.startswith("+++")]
if not added:
    print(fingerprint_line)
    sys.exit(0)

hits = sum(1 for p in patterns if any(p.search(ln) for ln in added))

if hits:
    fail(
        f"pre-commit: {hits} denylist pattern(s) matched in the staged diff.",
        "",
        # The matching line is deliberately not printed: it is the secret.
        "  This repository is public. Move the content outside the repository.",
        "  Review with: git diff --cached",
    )

print(fingerprint_line)
sys.exit(0)
