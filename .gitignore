# secrets - never commit. See SECURITY.md.
*.key
*.pem
*.p12
*.pfx
*.csr
*.srl
# Any certificate, not only the two names the scripts happen to produce:
# docs/CERTIFICATES.md tells readers to build a chain file, and it will not be
# called ca.crt or server.crt.
*.crt
ca.crt
ca.key
server.crt
server.key
token*
config.toml
whitelist*

# build
frontend/node_modules/
frontend/dist/
frontend/dev-dist/
frontend/coverage/
# playwright artifacts: screenshots and traces are uploaded by CI, never
# committed, and there are no screenshot baselines by design (SPEC 10.5).
frontend/test-results/
frontend/playwright-report/
frontend/.svelte-kit/
dist.tgz
*.tgz
SHA256SUMS

# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# local-only, never published. See SPEC.md section 13.
.claude/settings.local.json
*.local.md
*.local.json
*.local.toml
denylist*
.env
.env.*

# real capture data is location data about a person
*.pcap
*.pcapng
*.gps.json
# synthetic test fixtures are the one exception, and must stay synthetic
!tests/fakes/fixtures/**

# editors and os
.DS_Store
*.swp
.idea/
.vscode/

# coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
